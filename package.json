{
  "name": "enjoytrip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:live": "vite --host 127.0.0.1 --mode live",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "rules:check": "vitest run tests/runtime.test.js tests/harness-config.test.js tests/services.test.js",
    "harness": "npm test && npm run build && npm run test:e2e",
    "dev:map": "vite --host 127.0.0.1 --mode map"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "cannon-es": "0.20.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "jsdom": "^28.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
